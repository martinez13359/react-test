generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Anbieter {
  id            Int                  @id @default(autoincrement())
  name          String
  stadt         String
  adresse       String
  email         String
  telefon       String
  beschreibung  String
  bewertung     Float
  zertifikate   String[]
  oeffnungszeiten Json
  bild          String

  services      AnbieterService[]
  termintypen   AnbieterTermintyp[]
}

model Servicekategorie {
  id       Int               @id @default(autoincrement())
  name     String            @unique
  anbieter AnbieterService[]
}

model Termintyp {
  id       Int                 @id @default(autoincrement())
  name     String              @unique
  anbieter AnbieterTermintyp[]
}

model AnbieterService {
  anbieterId Int
  serviceId  Int

  anbieter   Anbieter         @relation(fields: [anbieterId], references: [id])
  service    Servicekategorie @relation(fields: [serviceId], references: [id])

  @@id([anbieterId, serviceId])
}

model AnbieterTermintyp {
  anbieterId  Int
  termintypId Int

  anbieter    Anbieter  @relation(fields: [anbieterId], references: [id])
  termintyp   Termintyp @relation(fields: [termintypId], references: [id])

  @@id([anbieterId, termintypId])
}